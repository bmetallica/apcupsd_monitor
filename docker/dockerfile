# Basis-Image
FROM node:24-alpine

# Arbeitsverzeichnis
WORKDIR /usr/src/app

# Sicherheitsupdates und Tools für apcaccess (apcupsd-Paket)
RUN apk upgrade --no-cache && \
    apk add --no-cache apcupsd

# package.json und package-lock.json kopieren
COPY package*.json ./

# Abhängigkeiten installieren, danach npm/yarn entfernen (zur Laufzeit nicht nötig)
RUN npm install --omit=dev && \
    rm -rf /usr/local/lib/node_modules /usr/local/bin/npm /usr/local/bin/npx \
           /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg /opt/yarn-*

# Projekt kopieren
COPY . .

# Exponierter Port
EXPOSE 3000

# Startbefehl
CMD ["node", "server.js"]
